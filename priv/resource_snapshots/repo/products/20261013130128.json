      "code?": false,
      "down": "DROP FUNCTION IF EXISTS mercator_product_document(regconfig, text, jsonb, jsonb, jsonb);",
      "global?": false,
      "name": "product_search_document",
      "up": "CREATE OR REPLACE FUNCTION mercator_product_document(lang regconfig, locale text, title jsonb, subtitle jsonb, description jsonb)\nRETURNS tsvector LANGUAGE sql IMMUTABLE PARALLEL SAFE AS $$\n  SELECT setweight(to_tsvector(lang, coalesce(title->>locale, '')), 'A') ||\n         setweight(to_tsvector(lang, coalesce(subtitle->>locale, '') || ' ' || coalesce(description->>locale, '')), 'B')\n$$;\n"
    },
    {
      "after_tables": [],
      "code?": false,
      "down": "DROP INDEX IF EXISTS products_search_de_index;",
      "global?": false,
      "name": "products_search_de_index",
      "up": "CREATE INDEX products_search_de_index ON products USING gin (mercator_product_document('german', 'de', title, subtitle, description));"
    },
    {
      "after_tables": [],
      "code?": false,

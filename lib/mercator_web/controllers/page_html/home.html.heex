<Layouts.app flash={@flash} current_user={@current_user} locale={@locale}>
  <div class="hero bg-base-200 rounded-box py-16" id="home-hero">
    <div class="hero-content text-center">
      <div class="max-w-md">
        <h1 class="text-4xl font-bold">Mercator</h1>
        <p class="py-6">
          {gettext("Shop on your own or get advice from our consultants.")}
        </p>
      </div>
    </div>
  </div>
</Layouts.app>

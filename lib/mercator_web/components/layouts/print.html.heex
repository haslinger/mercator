<!DOCTYPE html>
<html lang={assigns[:locale] || "de"} data-theme={Mercator.Brand.get(:light_theme)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <%!-- app.js reads it at start --%>
    <meta name="csrf-token" content={get_csrf_token()} />
    <title>{assigns[:page_title]} · {Mercator.Brand.name()}</title>
    <link rel="icon" href={~p"/brand/favicon"} />
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
  </head>
  <body class="bg-base-200 print:bg-white">
    {@inner_content}
  </body>
</html>

# Settings and secrets of a Mercator deployment (DOCKER.md). Copy to .env
# (gitignored) and fill in:
#
#   cp .env.example .env
#   $EDITOR .env
#   docker compose up -d
#
# docker compose reads .env automatically; nothing of it is baked into the
# image. After changing it, `docker compose up -d` is enough (no rebuild).

# --- Database (shared by the db and app services) ---
POSTGRES_PASSWORD=change-me

# --- Phoenix ---
# openssl rand -base64 48   (once each, different values)
SECRET_KEY_BASE=paste-the-output-of-openssl-rand-base64-48
TOKEN_SIGNING_SECRET=paste-another-output-of-openssl-rand-base64-48

# The public host name, used for links in emails, PDFs and payment pages
PHX_HOST=biber.mittenin.at

# Port on 127.0.0.1 the reverse proxy forwards to (default 4010)
# APP_PORT=4010

# Addresses or networks of the reverse proxy whose X-Forwarded-For header is
# believed (client IPs for rate limits). Default: Docker's networks.
# TRUSTED_PROXIES=172.16.0.0/12

# --- Email (SMTP) ---
MAIL_FROM_ADDRESS=robot@mittenin.at
MAIL_FROM_NAME=Biber Holz
SMTP_RELAY=box.mittenin.at
# 465 = TLS from the start (default); 587 = STARTTLS
SMTP_PORT=465
SMTP_USERNAME=robot@mittenin.at
SMTP_PASSWORD=change-me
# Only if the mail server's certificate cannot be verified:
# SMTP_TLS_VERIFY=false

# --- Brand ---
# One of the brands in config/brands/ (#43); empty = the neutral Mercator look
BRAND=biberholz

# --- Demo mode (#48) ---
# "demo": seeds the demo data, public demo logins, payment simulator,
# nightly reset at 03:00 (see DOCKER.md).
# Leave empty for a real shop.
MERCATOR_MODE=demo
# The demo administrator's password (never shown publicly, #45);
# at least 8 characters, the app refuses to start with "change-me"
DEMO_ADMIN_PASSWORD=change-me

# --- Online payment (phase 7) ---
# Mollie API key: test_… only simulates payments (use it for the demo),
# live_… takes real money. Then switch Mollie on in the back office
# (Verwaltung → Zahlungsanbieter). Empty: Mollie is not available.
# MOLLIE_API_KEY=

# --- Phone notifications for the sales desk (Web Push, #151) ---
# The shop's key pair, from `mix mercator.gen.vapid` (free, no account).
# Empty: no phone notifications. Optional VAPID_SUBJECT (default:
# mailto:MAIL_FROM_ADDRESS) is the contact the push services see.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=

# --- Advice ---
# Seconds a customer waits for a consultant before the callback form
# appears (default 180)
# CONSULTING_WAIT_SECONDS=180

# --- Video calls (phase 10, DOCKER.md "Video calls") ---
# The public host name (or IP) browsers reach the call media at, usually the
# same as PHX_HOST. Without it, calls only work inside the local network.
CALL_PUBLIC_HOST=biber.mittenin.at
# The UDP ports for call media (default 50000-50049), published with the same
# numbers; forward them in the router to this server and open them in the
# firewall for APP_IP.
# CALL_PORT_RANGE=50000-50049
# Optional STUN servers (comma-separated), e.g. stun:stun.example.org:3478
# CALL_ICE_SERVERS=
# The app's network and fixed address (change both if 172.30.0.0/24 is taken)
# MERCATOR_SUBNET=172.30.0.0/24
# APP_IP=172.30.0.10
